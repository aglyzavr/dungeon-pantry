# App
APP_PORT=8080
APP_ENV=production

# Database — Option A: single URL (Railway / Heroku style)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Database — Option B: individual vars (docker-compose / local dev style)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=campaigns
POSTGRES_USER=replace_dnd_user
POSTGRES_PASSWORD=change_me_please

# Sessions
SESSION_SECRET_KEY=replace_with_a_random_32plus_char_string
SESSION_DURATION_DAYS=30

# DM seed account — set on first deploy to create the DM login
# DM_SEED_USERNAME=dm
# DM_SEED_PASSWORD=change_me
